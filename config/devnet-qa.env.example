# Devnet QA release build. Use the same stable extension identity configured
# as EMBER_DEVNET_QA_EXTENSION_ORIGIN in the API.
WXT_EMBER_ENVIRONMENT=sandbox
WXT_EMBER_API_BASE_URL=https://REPLACE_WITH_QA_API_ORIGIN
WXT_EMBER_INTEGRATION_ID=integration_reference-wallet
WXT_EMBER_INTEGRATION_VERSION=1
# The stable Chrome Web Store ID and public manifest key are source-controlled
# in src/config/chrome-identity.ts.
WXT_SOLANA_RPC_URL=https://REPLACE_WITH_DEVNET_RPC_ORIGIN
