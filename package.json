    "dev:test": "bun scripts/dev-test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@solana/kit": "^2.0.0",
    "@solana/wallet-standard-chains": "1.1.1",
    "@solana/wallet-standard-features": "1.3.0",
    "@wallet-standard/core": "1.1.1",
    "@webext-core/messaging": "3.0.2",
    "@webext-core/proxy-service": "2.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "wxt": "0.20.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@wxt-dev/auto-icons": "1.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "^5.7.0",
    "vitest": "4",
    "wrangler": "^4.101.0"
  }
