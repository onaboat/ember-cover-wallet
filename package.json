{
  "name": "ember-cover-wallet",
  "version": "0.16.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "verify:qa": "bun scripts/verify-qa-build.ts",
    "build:qa": "wxt build && bun scripts/verify-qa-build.ts",
    "postinstall": "wxt prepare",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "WXT_EMBER_ENVIRONMENT=sandbox WXT_EMBER_API_BASE_URL=http://127.0.0.1:18787 WXT_EMBER_INTEGRATION_ID=integration_reference-wallet WXT_SOLANA_RPC_URL=http://127.0.0.1:18787 wxt build && playwright test",
    "dev:test": "bun scripts/dev-test.ts",
    "dev:api": "bun scripts/dev-api.ts"
  },
  "dependencies": {
    "@embercover/wallet-sdk": "file:vendor/embercover-wallet-sdk-1.3.1.tgz",
    "@noble/hashes": "^1.5.0",
    "@solana-program/token": "^0.14.0",
    "@solana/kit": "^6.10.0",
    "@solana/wallet-standard-chains": "1.1.1",
    "@solana/wallet-standard-features": "1.3.0",
    "@wallet-standard/core": "1.1.1",
    "@webext-core/messaging": "3.0.2",
    "@webext-core/proxy-service": "2.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "wxt": "0.20.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@wxt-dev/auto-icons": "1.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "^5.7.0",
    "vitest": "4"
  }
}
