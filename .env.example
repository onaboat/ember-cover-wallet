# Cover proxy (Cloudflare Worker) base URL the extension calls. Dev default is the local proxy.
WXT_COVER_PROXY_URL=http://127.0.0.1:8787
# Solana cluster: devnet | mainnet
WXT_COVER_CLUSTER=devnet
# Solana Subscriptions Delegation Program. Defaults to the canonical program, but keep explicit in releases.
WXT_EMBER_SUBSCRIPTION_PROGRAM_ID=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44
# SPL Token program for USDC.
WXT_EMBER_SUBSCRIPTION_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# Production mainnet USDC defaults to EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v if omitted.
WXT_EMBER_SUBSCRIPTION_MAINNET_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet/local test mint must be created and funded in test wallets before activation works.
WXT_EMBER_SUBSCRIPTION_DEVNET_USDC_MINT=
# Ember merchant and approved puller wallets must match the onchain plan allowlist.
WXT_EMBER_SUBSCRIPTION_MERCHANT=
WXT_EMBER_SUBSCRIPTION_PULLER=
# Onchain plan IDs created by the Ember merchant. Do not guess these in the extension.
WXT_EMBER_SUBSCRIPTION_CORE_MONTHLY_PLAN_ID=
WXT_EMBER_SUBSCRIPTION_PLUS_MONTHLY_PLAN_ID=
WXT_EMBER_SUBSCRIPTION_MAX_MONTHLY_PLAN_ID=
WXT_EMBER_SUBSCRIPTION_CORE_ANNUAL_PLAN_ID=
WXT_EMBER_SUBSCRIPTION_PLUS_ANNUAL_PLAN_ID=
WXT_EMBER_SUBSCRIPTION_MAX_ANNUAL_PLAN_ID=
# NOTE: the Ember partner API key and the Helius RPC key are SERVER-SIDE Worker secrets only.
# They must NEVER appear in the extension build or in this repo.
