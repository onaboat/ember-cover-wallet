# Cover proxy (Cloudflare Worker) base URL the extension calls.
WXT_COVER_PROXY_URL=https://ember-cover-proxy.onaboat.workers.dev
# Solana cluster: devnet | mainnet
WXT_COVER_CLUSTER=devnet
# Put the Alchemy endpoint in .env.local; do not commit its API key.
WXT_SOLANA_DEVNET_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
WXT_SOLANA_MAINNET_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# One-off Devnet Ember Cover payment. These defaults mirror the deployed API contract.
WXT_EMBER_PAY_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
WXT_EMBER_PAY_TREASURY=AmXrozEs535RMiwSxkjhcyuq5reC9ntvtBXCef8wCP6s
WXT_EMBER_PAY_AMOUNT=1000000
WXT_EMBER_PAY_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# EMBER_PARTNER_API_KEY remains a server-side Worker secret and must never be added here.
