# Direct, secretless Ember wallet SDK configuration.
WXT_EMBER_ENVIRONMENT=sandbox
WXT_EMBER_API_BASE_URL=http://127.0.0.1:18787
WXT_EMBER_INTEGRATION_ID=integration_reference-wallet
# Production only: the stable ID derived from WXT_EXTENSION_PUBLIC_KEY.
WXT_EMBER_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
# Public Chrome manifest key only. Never add a private signing key to this repository or env file.
WXT_EXTENSION_PUBLIC_KEY=BASE64_DER_PUBLIC_KEY
# One build is bound to one RPC origin and cluster. Any token in this public extension URL is visible.
WXT_SOLANA_RPC_URL=https://api.devnet.solana.com
# Offers, price, terms, treasury, mint, and quote reference come only from signed Ember responses.
